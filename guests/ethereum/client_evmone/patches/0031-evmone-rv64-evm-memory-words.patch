+/// The EVM memory allocation starts on a word boundary and grows in 32-byte
+/// units. For an admitted 32-byte write both boundary words lie in that
+/// allocation; preserve every byte outside the requested word.
+[[gnu::always_inline]] inline void stwo_mstore_word(uint8_t* p, const uint256& value) noexcept
+{
+    const auto masks = intx::be_bytes::g_swap_masks;
+    uint64_t w[4]{};
+    if ((value[1] | value[2] | value[3]) != 0)
+    {
+        w[0] = intx::be_bytes::bswap64(value[3], masks);
+        w[1] = intx::be_bytes::bswap64(value[2], masks);
+        w[2] = intx::be_bytes::bswap64(value[1], masks);
+    }
+    w[3] = intx::be_bytes::bswap64(value[0], masks);
+    const auto off = reinterpret_cast<uintptr_t>(p) & 7;
+    auto* const a = static_cast<uint8_t*>(__builtin_assume_aligned(p - off, 8));
+    if (off == 0)
+    {
+        for (size_t i = 0; i != 4; ++i) std::memcpy(a + 8 * i, &w[i], 8);
+        return;
+    }
+    const auto sh = off * 8;
+    const auto rs = 64 - sh;
+    const uint64_t mask = ~uint64_t{0} << sh;
+    uint64_t first, last;
+    std::memcpy(&first, a, 8);
+    std::memcpy(&last, a + 32, 8);
+    first = (first & ~mask) | (w[0] << sh);
+    last = (last & mask) | (w[3] >> rs);
+    std::memcpy(a, &first, 8);
+    for (size_t i = 1; i != 4; ++i)
+    {
+        const uint64_t middle = (w[i - 1] >> rs) | (w[i] << sh);
+        std::memcpy(a + 8 * i, &middle, 8);
+    }
+    std::memcpy(a + 32, &last, 8);
+}
